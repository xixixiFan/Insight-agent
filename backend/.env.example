LLM_PROVIDER=alibaba
LLM_API_KEY_ENV=LLM_API_KEY
LLM_API_KEY=your-llm-api-key
LLM_MODEL=qwen3.6-flash-2026-04-16
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_COMPATIBILITY_MODE=openai_compatible_chat

EMBEDDING_PROVIDER=alibaba
EMBEDDING_API_KEY_ENV=EMBEDDING_API_KEY
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_COMPATIBILITY_MODE=openai_compatible
EMBEDDINGS_ENABLED=1

VECTOR_BACKEND=auto
VECTOR_BACKEND_FALLBACK=sqlite_ann
RETRIEVAL_RERANKER_ENABLED=1
RETRIEVAL_RERANKER_BACKEND=auto
RETRIEVAL_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_RERANKER_DEVICE=cpu
RETRIEVAL_RERANKER_BATCH_SIZE=8
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION_PREFIX=repo_autonomy_
PGVECTOR_DSN=
PGVECTOR_TABLE=repo_autonomy_vectors

GITHUB_ACTIONS_ENABLED=1
GITHUB_TOKEN=your-github-token
GITHUB_REPOSITORY=second196/simple_repo
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28

GITLAB_CI_ENABLED=0
GITLAB_TOKEN=   
GITLAB_API_URL=https://gitlab.com/api/v4
GITLAB_PROJECT_ID=

JENKINS_ENABLED=1
JENKINS_USERNAME=admin
JENKINS_TOKEN=your-jenkins-token
JENKINS_BASE_URL=http://localhost:32768
JENKINS_JOB_NAME=simple-repo-cli


API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173
API_BOOTSTRAP_DEMO=0
REQUIRE_REMOTE_EXECUTION_APPROVAL=0
ALLOW_UNAPPROVED_LOCAL_VALIDATION=1
REQUIRE_GITHUB_WRITE_APPROVAL=0
